# ============================================================
# Supabase
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxx

# ============================================================
# WhatsApp Business Platform — Cloud API oficial de Meta
# (un solo número centralizado / una sola WABA para toda la plataforma)
# ============================================================
WHATSAPP_TOKEN=EAAxxxxxx                 # token permanente del System User
WHATSAPP_PHONE_NUMBER_ID=1234567890      # phone_number_id del número central
WHATSAPP_VERIFY_TOKEN=un_token_secreto   # el mismo que registras en el webhook de Meta
WHATSAPP_API_VERSION=v20.0               # opcional
WHATSAPP_TEMPLATE_LANG=es_MX             # idioma de las plantillas aprobadas
NEXT_PUBLIC_WHATSAPP_NUMBER=521XXXXXXXXXX # número central (solo dígitos) para links wa.me

# Nombres de plantillas aprobadas en Meta (opcional; hay defaults)
# WA_TMPL_CONFIRMACION=confirmacion_cita
# WA_TMPL_RECORDATORIO=recordatorio_cita
# WA_TMPL_CANCELACION=cancelacion_cita
# WA_TMPL_REAGENDADO=reagendado_cita
# WA_TMPL_RESUMEN=resumen_diario

# ============================================================
# IA — Mía (asistente del dueño) + STT
# ============================================================
ANTHROPIC_API_KEY=sk-ant-xxxxxx          # Claude Haiku 4.5 (default) + Sonnet (fallback)
OPENAI_API_KEY=sk-xxxxxx                 # Whisper para transcribir notas de voz

# ============================================================
# Stripe
# ============================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxx
STRIPE_SECRET_KEY=sk_live_xxxxxx
STRIPE_PRICE_ID_MONTHLY=price_xxxxxx
STRIPE_PRICE_ID_ANNUAL=price_xxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxx

# ============================================================
# App
# ============================================================
NEXT_PUBLIC_APP_URL=https://tu-dominio.vercel.app

# ============================================================
# Seguridad (Vercel Cron + worker)
# ============================================================
CRON_SECRET=tu_cron_secret_aleatorio
